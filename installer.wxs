<?xml version="1.0" encoding="UTF-8"?>
<!--
  ING AutoLister - WiX installer
  Build:  wix build installer.wxs -d SourceDir=.\ING eBay AutoLister\dist\ -o installer-out\ING-AutoLister-Setup.msi
  Prereq: dotnet tool install -g wix

  Installs per-machine (requires UAC / admin elevation).
    Exe      -> %ProgramFiles%\ING Mining\ING AutoLister\
    Service  -> INGAutoLister  (auto-start at boot, LocalSystem)
    Startup  -> HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run (all users)
    Data     -> C:\ProgramData\ING AutoLister\  (app auto-creates on first run)
  Shortcuts: Desktop, Start Menu
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="ING AutoLister"
           Manufacturer="ING Mining LLC"
           Version="2.6.0.0"
           UpgradeCode="{7A8F9B2C-3D4E-5F60-A1B2-C3D4E5F6A7B8}"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of ING AutoLister is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!--
      Visible install wizard: without this, the package has zero UI (no dialogs, not even
      a progress bar) — double-clicking it shows a UAC prompt and then nothing, which reads
      as "the installer doesn't work" even when the install succeeds silently in the background.
    -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.RepoDir)license.rtf" />
    <Icon Id="AppIcon" SourceFile="$(var.RepoDir)ING eBay AutoLister\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Install directory: C:\Program Files\ING Mining\ING AutoLister\ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ING_MINING_DIR" Name="ING Mining">
        <Directory Id="INSTALLFOLDER" Name="ING AutoLister">

          <!-- Main executable. NO Windows service: the app runs as the logged-in USER
               (via the HKLM Run key below + the finish-screen launch), because its
               interactive features (the Terapeak login browser via Playwright) cannot
               work from a LocalSystem service — the service account can't find the user's
               Playwright and can't show a browser on the user's desktop. -->
          <Component Id="MainExeComp" Guid="{A2B3C4D5-E6F7-0001-1234-567890ABCDEF}">
            <File Id="MainExeFile"
                  Source="$(var.SourceDir)AutoListerB1.exe"
                  KeyPath="yes"
                  Checksum="yes" />
          </Component>

          <!--
            Pre-configured credentials template. CredentialsStore.cs reads/writes this exact
            path (Program Files\...\credentials.json) at runtime — it's the same file the app
            saves your real API keys and eBay OAuth tokens into after setup. Empirically verify
            reinstall behavior before assuming this needs an overwrite guard (WiX v4/v5 dropped
            the v3 NeverOverwrite attribute; MSI's default versioned-file rules may already do
            the right thing here since this file gets modified post-install).
          -->
          <Component Id="CredentialsComp" Guid="{A2B3C4D5-E6F7-0002-1234-567890ABCDEF}">
            <File Id="CredentialsFile"
                  Source="$(var.SourceDir)credentials.json"
                  KeyPath="yes" />
          </Component>

          <!--
            HKLM Run key: launches the tray helper exe for every user who logs in.
            Startup folder shortcuts only fire for the user who ran the installer;
            HKLM\Run fires for ALL users on every login session.
            The exe detects the service is running, opens the browser, and stays
            resident as a tray icon.
          -->
          <Component Id="StartupRegComp" Guid="{A2B3C4D5-E6F7-0006-1234-567890ABCDEF}">
            <RegistryValue Root="HKLM"
                           Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                           Name="INGAutoLister"
                           Type="string"
                           Value="[INSTALLFOLDER]AutoListerB1.exe"
                           KeyPath="yes" />
          </Component>

        </Directory>
      </Directory>
    </StandardDirectory>

    <!--
      Framework-dependent runtime files: since PublishSingleFile is off (the bundled single
      exe was getting quarantined by endpoint AV as a false-positive packer/dropper), publish
      now drops ~390 loose files (DLLs, deps.json, etc.) next to AutoListerB1.exe. Harvest
      everything in SourceDir except the two files that are already their own Component above
      (AutoListerB1.exe carries the ServiceInstall; credentials.json gets redacted separately
      by build-installer.ps1).
    -->
    <ComponentGroup Id="RuntimeFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)**">
        <Exclude Files="$(var.SourceDir)AutoListerB1.exe" />
        <Exclude Files="$(var.SourceDir)credentials.json" />
      </Files>
    </ComponentGroup>

    <!-- Desktop shortcut -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComp" Guid="{A2B3C4D5-E6F7-0004-1234-567890ABCDEF}">
        <Shortcut Id="DesktopShortcut"
                  Name="ING AutoLister"
                  Description="ING Listing Engine by ING Mining LLC"
                  Target="[INSTALLFOLDER]AutoListerB1.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\INGMining\AutoLister"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuING" Name="ING Mining">
        <Component Id="StartMenuShortcutComp" Guid="{A2B3C4D5-E6F7-0005-1234-567890ABCDEF}">
          <Shortcut Id="StartMenuShortcut"
                    Name="ING AutoLister"
                    Description="ING Listing Engine by ING Mining LLC"
                    Target="[INSTALLFOLDER]AutoListerB1.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU"
                         Key="Software\INGMining\AutoLister"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
          <RemoveFolder Id="RemoveStartMenuING" Directory="StartMenuING" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Feature set -->
    <Feature Id="Main" Level="1">
      <ComponentRef Id="MainExeComp" />
      <ComponentRef Id="CredentialsComp" />
      <ComponentRef Id="StartupRegComp" />
      <ComponentGroupRef Id="RuntimeFiles" />
      <ComponentRef Id="DesktopShortcutComp" />
      <ComponentRef Id="StartMenuShortcutComp" />
    </Feature>

    <!--
      Reserve TCP port 9332 for the app. On PCs with Hyper-V / WSL / Docker, Windows sets aside
      random blocks of ports at every boot (WinNAT "dynamic port exclusions"); when a block lands
      on 9332 the app cannot bind it and dies with "port in use" while netstat shows nothing —
      and 9332 is the one port the eBay OAuth relay ever redirects to, so moving is not an option.
      The install is already elevated (perMachine), which is the only time this fix is free.

      The command is three attempts in one line:
        1. delete any stale reservation of ours (fails harmlessly if absent — makes the add clean
           on repair/upgrade instead of erroring as a duplicate),
        2. add a persistent ADMINISTERED exclusion for exactly 9332 — the dynamic allocator must
           skip administered entries at every future boot, while normal programs can still bind,
        3. only if the add failed (9332 is already inside a dynamic block right now), bounce the
           winnat service — stopping it releases the dynamic blocks so the add lands — then start
           it again so Hyper-V/WSL networking comes straight back.
      Return="ignore" because a machine where netsh fails (no winnat, odd policy) must still get
      the app installed; the app's own startup message names the manual fix for that case.
    -->
    <!-- Plain exe actions rather than the util extension's WixQuietExec: the build script only
         carries WixToolset.UI.wixext, and a deferred non-impersonated action runs in the
         installer service's session anyway, so no console window ever reaches the desktop. -->
    <CustomAction Id="ReservePort9332"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /d /c &quot;netsh int ipv4 delete excludedportrange protocol=tcp startport=9332 numberofports=1 store=persistent &amp; netsh int ipv4 add excludedportrange protocol=tcp startport=9332 numberofports=1 store=persistent || (net stop winnat &amp; netsh int ipv4 add excludedportrange protocol=tcp startport=9332 numberofports=1 store=persistent &amp; net start winnat)&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Give the reservation back on a real uninstall — not on the uninstall half of an upgrade,
         where the new version still wants it. Leaving it behind would be harmless but rude. -->
    <CustomAction Id="UnreservePort9332"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /d /c &quot;netsh int ipv4 delete excludedportrange protocol=tcp startport=9332 numberofports=1 store=persistent&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="ReservePort9332" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="UnreservePort9332" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- Finish screen: a checked-by-default "Open ING AutoLister now" checkbox so the
         user lands in the app immediately and knows how to open it. It launches the
         installed exe with the open-browser flag, which only opens the web UI (no port
         bind), so it never fights the background service that already owns port 9332. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open ING AutoLister now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApplication"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]AutoListerB1.exe&quot;"
                  Return="asyncNoWait"
                  Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

  </Package>
</Wix>
