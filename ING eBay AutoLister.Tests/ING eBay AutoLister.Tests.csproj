<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ING_eBay_AutoLister.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned directly, though nothing here calls it: Microsoft.Data.Sqlite 10.0.8 pulls
         SQLitePCLRaw 2.1.11, whose bundled SQLite carries GHSA-2m69-gcr7-jv3q (high), and
         every build warned NU1903 about it. There is no Microsoft.Data.Sqlite release that
         moves off it — 11.0.0 is preview-only — so the transitive is overridden here instead.
         Remove this line when a stable Microsoft.Data.Sqlite brings 3.x of its own. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- HostedAuthTests starts a real Kestrel server and drives the sign-in over HTTP, because the
         thing under test is a middleware pipeline: an authorization policy that never runs proves
         nothing. That needs the ASP.NET Core shared framework here, not just in the app. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ING eBay AutoLister\ING eBay AutoLister.csproj" />
  </ItemGroup>

</Project>