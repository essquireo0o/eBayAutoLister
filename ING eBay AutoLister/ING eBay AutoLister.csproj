<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ── Which shell is this build wearing? ────────────────────────────────────
       The 189 endpoints and every service are platform-neutral; the only Windows in this project
       is the shell around them — tray icon, message boxes, single-instance mutex. Two builds share
       that one body:

         desktop (default)  dotnet build
         hosted             dotnet publish -c Release -r linux-x64 -p:DefineConstants=HOSTED
                            (or the friendlier -p:Hosted=true, which defines HOSTED for you)

       Hosted is inferred from the HOSTED constant so the published binary and the csproj can never
       disagree about which one is being built — a net10.0-windows assembly compiled with HOSTED, or
       a plain net10.0 one still compiling the tray icon, are both builds that fail at a much less
       obvious moment than here.
       The '$(DefineConstants)' != '' guard is load-bearing: MSBuild conditions short-circuit, and
       calling .Contains on an undefined property is an evaluation error, not false. -->
  <PropertyGroup>
    <Hosted Condition="'$(Hosted)' == '' And '$(DefineConstants)' != '' And $(DefineConstants.Contains('HOSTED'))">true</Hosted>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Hosted)' == 'true'">
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- No-op when HOSTED arrived as a global property (-p:DefineConstants=HOSTED), which is
         already defined for the compiler; this is what makes -p:Hosted=true work on its own. -->
    <DefineConstants>$(DefineConstants);HOSTED</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Hosted)' != 'true'">
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Windows PE resource. Meaningless to a linux-x64 apphost. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>ING_eBay_AutoLister</RootNamespace>
    <AssemblyName>AutoListerB1</AssemblyName>

    <!-- Ownership, embedded into the compiled assembly so the copyright travels with the binary
         (Windows file properties -> Details -> Copyright) as well as living in license.rtf and
         COPYRIGHT.md. ING Mining LLC is the owner; Nick Squires is the author. -->
    <Company>ING Mining LLC</Company>
    <Authors>Nick Squires</Authors>
    <Product>ING Listing Engine</Product>
    <Copyright>Copyright © 2026 ING Mining LLC — Nick Squires. All rights reserved.</Copyright>
    <Trademark>ING Listing Engine™ is a trademark of ING Mining LLC.</Trademark>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- The number the running app compares against the latest GitHub release to decide whether to
         tell the seller an update exists. Without it the assembly reports 1.0.0, every release looks
         newer, and the banner cries wolf on a fresh install forever.
         BUMP THIS IN THE SAME COMMIT AS THE RELEASE TAG. -->
    <Version>2.6.12</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned directly, though nothing here calls it: Microsoft.Data.Sqlite 10.0.8 pulls
         SQLitePCLRaw 2.1.11, whose bundled SQLite carries GHSA-2m69-gcr7-jv3q (high), and
         every build warned NU1903 about it. There is no Microsoft.Data.Sqlite release that
         moves off it — 11.0.0 is preview-only — so the transitive is overridden here instead.
         Remove this line when a stable Microsoft.Data.Sqlite brings 3.x of its own. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Anthropic.SDK" Version="5.10.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Stripe.net" Version="51.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- credentials.json is the live secrets of whichever machine is doing the build - the eBay app
         client secret, the seller's OAuth refresh token, the Anthropic key, the Stripe secret key and
         webhook secret - and it sits in the project folder, so the Web SDK's default Content glob
         copies it into publish output. A publish is precisely how those secrets reach a server: the
         hosted build is published onto a box the developer does not own, and anything left in that
         folder goes with it. Excluded unconditionally rather than only under Hosted, because a
         secret that leaks in one of two configurations is a leaked secret.
         The desktop installer does not depend on this: build-installer.ps1 copies the publish output
         into dist and then writes its own REDACTED credentials.json over the top - the API keys blank,
         the tokens blank - so what ships has never been the published file.
         Recursive, not just the one beside this file: the desktop build publishes into
         "ING eBay AutoLister\dist" (see build-installer.ps1), which is gitignored but is still inside
         the project folder, so a hosted publish was picking up dist\credentials.json - a full copy of
         the unredacted file, secrets and all - even once the project-root one was excluded.
         Excluded from Content, not deleted - the app still reads it at runtime from beside the exe. -->
    <Content Remove="credentials.json" />
    <Content Remove="**\credentials.json" />
    <None Remove="credentials.json" />
    <None Remove="**\credentials.json" />

    <!-- wwwroot is also where the app writes its working images at runtime - AI photo generation
         (url_*.png) and background removal (rembg_*.png) both land here, and generated-photos/ is
         gitignored for that reason. The SDK's default Content glob then copies every one of them
         into publish output, so an installer built on a machine that has been used carries the
         seller's own scratch images to everyone who downloads it: measured 2026-07-30, 300 untracked
         files and 60MB of someone's listing photos in an 83MB installer. Only 9 files in wwwroot are
         actually part of the product, and all 9 are embedded below.
         Excluded from Content, not deleted - the app still reads and writes them at runtime. -->
    <Content Remove="wwwroot\generated-photos\**" />
    <Content Remove="wwwroot\url_*.png" />
    <Content Remove="wwwroot\rembg_*.png" />
    <Content Remove="wwwroot\*.dll" />
    <None Remove="wwwroot\generated-photos\**" />

    <!-- Embed static UI files into the assembly so the exe is self-contained -->
    <Content Remove="wwwroot\index.html" />
    <Content Remove="wwwroot\reauth.html" />
    <Content Remove="wwwroot\style.css" />
    <Content Remove="wwwroot\app.js" />
    <Content Remove="wwwroot\photobox-ux.js" />
    <Content Remove="wwwroot\favicon.svg" />
    <Content Remove="wwwroot\editor.html" />
    <Content Remove="wwwroot\autobuy.html" />
    <!-- The hosted build's sign-in and sign-up pages. Embedded in both builds rather than only
         under HOSTED: one list of UI files is one thing to get wrong, and the tests read these
         two out of this assembly to prove the allow-list actually serves them. -->
    <Content Remove="wwwroot\signin.html" />
    <Content Remove="wwwroot\signup.html" />
    <!-- The antiforgery client. Every one of the five pages above loads it, and a page that asks
         for a file this list does not carry gets the sign-in page's HTML back with a JavaScript
         content type — the embedded provider is the only thing serving /, so "not embedded" and
         "does not exist" are the same sentence. It shipped missing once, on 2026-08-14, and the
         symptom was that no POST in the hosted app worked at all: window.fetch was never wrapped,
         no token was ever sent, and every sign-in came back "could not be verified". See
         EmbeddedAssetTests, which now fails if any page references an asset that is not here. -->
    <Content Remove="wwwroot\csrf.js" />
    <EmbeddedResource Include="wwwroot\csrf.js" />
    <EmbeddedResource Include="wwwroot\index.html" />
    <EmbeddedResource Include="wwwroot\reauth.html" />
    <EmbeddedResource Include="wwwroot\style.css" />
    <EmbeddedResource Include="wwwroot\app.js" />
    <EmbeddedResource Include="wwwroot\photobox-ux.js" />
    <EmbeddedResource Include="wwwroot\favicon.svg" />
    <EmbeddedResource Include="wwwroot\editor.html" />
    <EmbeddedResource Include="wwwroot\autobuy.html" />
    <EmbeddedResource Include="wwwroot\signin.html" />
    <EmbeddedResource Include="wwwroot\signup.html" />

    <!-- Three more things the Web SDK's Content glob was quietly shipping to every downloader,
         measured in the 2.6.11 publish output on 2026-09-30:
           dist\**            the previous publish, nested one level deeper on every ship
                              (dist\dist\dist\... - the installed app carries a 174 KB matryoshka
                              of old deps.json/runtimeconfig/web.config files);
           App_Data\**        this machine's analytics.json - the owner's own usage counters;
           wwwroot\*.bak-*    two full copies of the August UI beside the embedded one.
         None of it is read by the app. Excluded, not deleted. -->
    <Content Remove="dist\**" />
    <None Remove="dist\**" />
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
    <Content Remove="wwwroot\*.bak-*" />
    <None Remove="wwwroot\*.bak-*" />
  </ItemGroup>

  <!-- ── The one-file build ────────────────────────────────────────────────────
       dotnet publish -c Release -r win-x64 -p:OneFile=true -p:DistCredentials=<redacted json>
       produces a single AutoListerB1.exe that carries the runtime, every dependency and the
       embedded UI: the "just download and run it" shape the owner asked for on 2026-09-30. The
       MSI keeps its folder-of-files layout (installer.wxs harvests a directory), so the two
       artefacts come from two publishes of the same commit.
       Compressed, because the difference is 66 MB against ~160 MB. build-installer.ps1 records
       that endpoint AV (Sophos/Bitdefender) once quarantined a single-file bundle on this machine
       as a packer; re-checked 2026-09-30 with both engines on-access plus a Defender scan of the
       compressed 2.6.11 bundle - nothing fired. If that changes, EnableCompressionInSingleFile is
       the first switch to flip. Native libraries (e_sqlite3) are extracted to %TEMP%\.net on the
       first run, which is the documented behaviour.
       The installed app and this exe share one data home (AppPaths.DataHome), so a seller can
       switch between them without losing a key or a marketplace connection. -->
  <PropertyGroup Condition="'$(OneFile)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The pre-configured credentials the MSI drops beside the exe (eBay app id, RuName, a blank
       Anthropic key - the REDACTED file build-installer.ps1 writes, never the live one) travel
       inside the one-file exe instead, and Program.cs writes them to the data home on a first
       run that has nothing there yet. Same file, same content, one fewer thing beside the exe.
       Only embedded when the publish names the file - a plain build has no template and must
       not accidentally pick up the live credentials.json. -->
  <ItemGroup Condition="'$(DistCredentials)' != '' And Exists('$(DistCredentials)')">
    <EmbeddedResource Include="$(DistCredentials)" Link="dist-credentials.json" LogicalName="AutoListerB1.dist-credentials.json" />
  </ItemGroup>
  <!-- A one-file exe without the template is an app whose eBay sign-in can never start, and
       nothing downstream would notice until a downloader did. Fail the publish instead. -->
  <Target Name="RequireDistCredentialsForOneFile" BeforeTargets="CoreCompile" Condition="'$(OneFile)' == 'true'">
    <Error Condition="'$(DistCredentials)' == '' Or !Exists('$(DistCredentials)')"
           Text="OneFile publish needs -p:DistCredentials=&lt;path to the REDACTED credentials.json build-installer.ps1 writes&gt;; got '$(DistCredentials)'." />
  </Target>

</Project>
