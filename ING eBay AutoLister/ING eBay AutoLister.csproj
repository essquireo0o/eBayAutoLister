<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ING_eBay_AutoLister</RootNamespace>
    <AssemblyName>AutoListerB1</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- The number the running app compares against the latest GitHub release to decide whether to
         tell the seller an update exists. Without it the assembly reports 1.0.0, every release looks
         newer, and the banner cries wolf on a fresh install forever.
         BUMP THIS IN THE SAME COMMIT AS THE RELEASE TAG. -->
    <Version>2.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic.SDK" Version="5.10.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Stripe.net" Version="51.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- wwwroot is also where the app writes its working images at runtime - AI photo generation
         (url_*.png) and background removal (rembg_*.png) both land here, and generated-photos/ is
         gitignored for that reason. The SDK's default Content glob then copies every one of them
         into publish output, so an installer built on a machine that has been used carries the
         seller's own scratch images to everyone who downloads it: measured 2026-07-30, 300 untracked
         files and 60MB of someone's listing photos in an 83MB installer. Only 7 files in wwwroot are
         actually part of the product, and all 7 are embedded below.
         Excluded from Content, not deleted - the app still reads and writes them at runtime. -->
    <Content Remove="wwwroot\generated-photos\**" />
    <Content Remove="wwwroot\url_*.png" />
    <Content Remove="wwwroot\rembg_*.png" />
    <Content Remove="wwwroot\*.dll" />
    <None Remove="wwwroot\generated-photos\**" />

    <!-- Embed static UI files into the assembly so the exe is self-contained -->
    <Content Remove="wwwroot\index.html" />
    <Content Remove="wwwroot\reauth.html" />
    <Content Remove="wwwroot\style.css" />
    <Content Remove="wwwroot\app.js" />
    <Content Remove="wwwroot\favicon.svg" />
    <Content Remove="wwwroot\editor.html" />
    <EmbeddedResource Include="wwwroot\index.html" />
    <EmbeddedResource Include="wwwroot\reauth.html" />
    <EmbeddedResource Include="wwwroot\style.css" />
    <EmbeddedResource Include="wwwroot\app.js" />
    <EmbeddedResource Include="wwwroot\favicon.svg" />
    <EmbeddedResource Include="wwwroot\editor.html" />
  </ItemGroup>

</Project>
